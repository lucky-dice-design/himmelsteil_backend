{$DIRECTUS_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy directus:8055
}

preview.himmelsteil.de {
  root * /srv/site
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Robots-Tag "noindex, nofollow, noarchive"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Strict-Transport-Security "max-age=31536000"
  }

  @legacy_home path /index.html
  @legacy_page path_regexp legacy_page ^/([a-z0-9-]+)\.html$

  route {
    basic_auth argon2id {
      preview {$PREVIEW_PASSWORD_HASH}
    }
    redir @legacy_home /{?query} 308
    redir @legacy_page /{re.legacy_page.1}{?query} 308
    handle_path /api/* {
      reverse_proxy contact:3000
    }
    header Cache-Control "no-store"
    try_files {path}.html {path}
    file_server
  }
}
