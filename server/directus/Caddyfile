{$DIRECTUS_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy directus:8055
}

himmelsteil.de {
  root * /srv/site
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  file_server
}

www.himmelsteil.de {
  redir https://himmelsteil.de{uri} permanent
}
